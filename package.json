{
  "name": "discord-music-bot",
  "version": "0.5.0",
  "description": "The music bot for discord",
  "main": "src/main.js",
  "scripts": {
    "start": "node -r @swc-node/register -r dotenv/config src/main.ts",
    "build": "tsc",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint . src/**/*.{ts,js}",
    "audit": "npx audit-ci@^7 --config ./.audit-ci.jsonc",
    "test": "vitest run --config ./src/test/vitest.config.ts",
    "test:watch": "vitest --config ./src/test/vitest.config.ts"
  },
  "repository": {
    "url": "https://github.com/Krysik/discord-music-bot"
  },
  "author": "Marcin Krysiński <marcin_krysinski@outlook.com>",
  "license": "ISC",
  "packageManager": "pnpm@12.3.4",
  "dependencies": {
    "@discordjs/opus": "^0.10.0",
    "@snazzah/davey": "^0.1.12",
    "discord-player": "^7.2.0",
    "discord-player-youtubei": "^2.0.0",
    "discord.js": "^14.27.0",
    "dotenv": "^16.6.1",
    "pino": "^9.14.0",
    "youtube-dl-exec": "^3.1.17"
  },
  "devDependencies": {
    "@swc-node/register": "^1.12.1",
    "@swc/core": "^1.16.18",
    "@types/node": "^22.20.5",
    "@typescript-eslint/eslint-plugin": "^5.62.0",
    "@typescript-eslint/parser": "^5.62.0",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^8.10.2",
    "eslint-plugin-prettier": "^5.5.7",
    "pino-pretty": "^13.2.0",
    "prettier": "^2.8.8",
    "typescript": "^5.9.3",
    "vite": "^8.3.4",
    "vitest": "^4.1.12"
  }
}
